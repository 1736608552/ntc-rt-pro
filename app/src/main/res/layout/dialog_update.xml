<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/lab_surface"
    android:orientation="vertical"
    android:padding="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvUpdateBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_active"
            android:paddingHorizontal="9dp"
            android:paddingVertical="3dp"
            android:text="版本检测"
            android:textColor="@color/lab_cyan"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvUpdateVersion"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:textColor="@color/lab_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvUpdateSize"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="@color/lab_amber"
            android:textSize="11.5sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvUpdateNotes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_hud_card"
        android:lineSpacingExtra="3dp"
        android:maxLines="6"
        android:padding="10dp"
        android:textColor="@color/lab_text_secondary"
        android:textSize="12sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="选择 CDN 加速线路（已自动测速优选）："
        android:textColor="@color/lab_text_secondary"
        android:textSize="11.5sp" />

    <LinearLayout
        android:id="@+id/layoutCdnMirrors"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="vertical" />

    <LinearLayout
        android:id="@+id/layoutDownloadProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical"
        android:visibility="gone">

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progressUpdateApk"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            app:indicatorColor="@color/lab_cyan"
            app:trackColor="@color/lab_border"
            app:trackCornerRadius="4dp" />

        <TextView
            android:id="@+id/tvUpdateProgressText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="monospace"
            android:textColor="@color/lab_cyan"
            android:textSize="11.5sp" />
    </LinearLayout>

</LinearLayout>
