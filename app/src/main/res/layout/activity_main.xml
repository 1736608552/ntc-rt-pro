<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lab_bg"
    android:orientation="vertical">

    <!-- 顶部仪器状态栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/lab_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_pill_active" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NTC R-T Pro"
                    android:textColor="@color/lab_text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_pill_active"
                    android:paddingHorizontal="7dp"
                    android:paddingVertical="1dp"
                    android:text="LAB"
                    android:textColor="@color/lab_cyan"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvTopSpecBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:text="R25=5Ω · B4100K · ±17%"
                android:textColor="@color/lab_cyan"
                android:textSize="11.5sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEditParams"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginEnd="6dp"
            android:minWidth="0dp"
            android:paddingHorizontal="12dp"
            android:text="调参"
            android:textColor="@color/lab_text_primary"
            android:textSize="12sp"
            app:cornerRadius="10dp"
            app:strokeColor="@color/lab_border" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExportPng"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:backgroundTint="@color/lab_cyan_dim"
            android:minWidth="0dp"
            android:paddingHorizontal="12dp"
            android:text="导出图"
            android:textColor="@color/lab_cyan"
            android:textSize="12sp"
            app:cornerRadius="10dp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/lab_border" />

    <!-- 主内容区域 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- ================= 页面 1：曲线工作台 ================= -->
        <ScrollView
            android:id="@+id/pageCurve"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <!-- 预设横向选择器 -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/layoutPresets"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <!-- 精密 HUD 实时游标读数卡 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_hud_card"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="0.9"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="游标温度 T"
                                android:textColor="@color/lab_text_muted"
                                android:textSize="10.5sp" />

                            <TextView
                                android:id="@+id/tvHudTemp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="monospace"
                                android:text="25.0 ℃"
                                android:textColor="@color/lab_text_primary"
                                android:textSize="18sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.25"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="标称阻值 R_nom"
                                android:textColor="@color/lab_text_muted"
                                android:textSize="10.5sp" />

                            <TextView
                                android:id="@+id/tvHudRNom"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="monospace"
                                android:text="5.0000 Ω"
                                android:textColor="@color/lab_cyan"
                                android:textSize="18sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="0.85"
                            android:gravity="end"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="灵敏度 α"
                                android:textColor="@color/lab_text_muted"
                                android:textSize="10.5sp" />

                            <TextView
                                android:id="@+id/tvHudAlpha"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="monospace"
                                android:text="-4.61%/℃"
                                android:textColor="@color/lab_amber"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="8dp"
                        android:background="@color/lab_border" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvHudRange"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="monospace"
                            android:text="允许区间: 4.1500 Ω ～ 5.8500 Ω"
                            android:textColor="@color/lab_text_secondary"
                            android:textSize="11.5sp" />

                        <TextView
                            android:id="@+id/tvHudCompare"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:textColor="@color/lab_rose"
                            android:textSize="11.5sp"
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 曲线图卡片 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_lab_card"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="4dp"
                        android:paddingBottom="6dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="R-T 特性包络曲线（指尖拖动准星读数）"
                            android:textColor="@color/lab_text_secondary"
                            android:textSize="11.5sp" />

                        <TextView
                            android:id="@+id/tvChartLegend"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:text="━ 标称  ┄ 上下限"
                            android:textColor="@color/lab_text_muted"
                            android:textSize="10.5sp" />
                    </LinearLayout>

                    <com.ntcrt.pro.NtcCurveView
                        android:id="@+id/ntcCurveView"
                        android:layout_width="match_parent"
                        android:layout_height="285dp" />

                    <!-- 图表模式切换条 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnToggleScale"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="34dp"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text="坐标: 线性"
                            android:textColor="@color/lab_cyan"
                            android:textSize="11sp"
                            app:cornerRadius="8dp"
                            app:strokeColor="@color/lab_border" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnToggleBand"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="34dp"
                            android:layout_marginHorizontal="4dp"
                            android:layout_weight="1"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text="公差带: 开"
                            android:textColor="@color/lab_emerald"
                            android:textSize="11sp"
                            app:cornerRadius="8dp"
                            app:strokeColor="@color/lab_border" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnToggleCompare"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="34dp"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text="对比曲线: 关"
                            android:textColor="@color/lab_text_secondary"
                            android:textSize="11sp"
                            app:cornerRadius="8dp"
                            app:strokeColor="@color/lab_border" />
                    </LinearLayout>

                    <!-- 游标精密调节滑块 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="温度定位"
                            android:textColor="@color/lab_text_muted"
                            android:textSize="11sp" />

                        <com.google.android.material.slider.Slider
                            android:id="@+id/sliderTemp"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            app:haloColor="@color/lab_cyan_dim"
                            app:thumbColor="@color/lab_cyan"
                            app:trackColorActive="@color/lab_cyan"
                            app:trackColorInactive="@color/lab_border" />

                        <TextView
                            android:id="@+id/btnJump25"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_pill_idle"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp"
                            android:text="25℃"
                            android:textColor="@color/lab_amber"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 器件规格摘要卡 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_lab_card"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/tvSpecSummaryTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="南京时恒电子科技有限公司 · XIN-5R0-B4100"
                        android:textColor="@color/lab_text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvSpecSummaryDetail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="monospace"
                        android:lineSpacingExtra="3dp"
                        android:textColor="@color/lab_text_secondary"
                        android:textSize="11.5sp" />
                </LinearLayout>

            </LinearLayout>
        </ScrollView>

        <!-- ================= 页面 2：阻值特性表 ================= -->
        <LinearLayout
            android:id="@+id/pageTable"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="12dp"
            android:visibility="gone">

            <!-- 查找与单位 bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/LabInputLayout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:hint="定位温度 T (℃)">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etTableSearchTemp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:inputType="numberDecimal|numberSigned"
                        android:textColor="@color/lab_text_primary"
                        android:textSize="13sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTableLocate"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:backgroundTint="@color/lab_cyan_dim"
                    android:text="跳转"
                    android:textColor="@color/lab_cyan"
                    android:textSize="12sp"
                    app:cornerRadius="10dp" />

                <TextView
                    android:id="@+id/tvTableUnitTag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_pill_idle"
                    android:fontFamily="monospace"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="8dp"
                    android:text="单位: Ω"
                    android:textColor="@color/lab_amber"
                    android:textSize="11.5sp" />
            </LinearLayout>

            <!-- 导出操作栏 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnExportCsv"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="导出 CSV"
                    android:textColor="@color/lab_emerald"
                    android:textSize="11.5sp"
                    app:cornerRadius="8dp"
                    app:strokeColor="@color/lab_border" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCopyMd"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_marginHorizontal="4dp"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="复制表格"
                    android:textColor="@color/lab_text_primary"
                    android:textSize="11.5sp"
                    app:cornerRadius="8dp"
                    app:strokeColor="@color/lab_border" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCopyCLut"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="C 查表代码"
                    android:textColor="@color/lab_cyan"
                    android:textSize="11.5sp"
                    app:cornerRadius="8dp"
                    app:strokeColor="@color/lab_border" />
            </LinearLayout>

            <!-- 固定表头 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@color/lab_surface_elevated"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp"
                android:paddingVertical="9dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.0"
                    android:fontFamily="monospace"
                    android:text="温度 T"
                    android:textColor="@color/lab_text_secondary"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.2"
                    android:fontFamily="monospace"
                    android:gravity="end"
                    android:text="下限 Rmin"
                    android:textColor="@color/lab_emerald"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.3"
                    android:fontFamily="monospace"
                    android:gravity="end"
                    android:text="标称 Rnom"
                    android:textColor="@color/lab_cyan"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.2"
                    android:fontFamily="monospace"
                    android:gravity="end"
                    android:text="上限 Rmax"
                    android:textColor="@color/lab_amber"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.0"
                    android:fontFamily="monospace"
                    android:gravity="end"
                    android:text="α (%/℃)"
                    android:textColor="@color/lab_text_secondary"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvRtTable"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/bg_lab_card" />
        </LinearLayout>

        <!-- ================= 页面 3：工程反推与分压仿真 ================= -->
        <ScrollView
            android:id="@+id/pageTools"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <!-- 工具 1：R <-> T 双向精算 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_lab_card"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1. 阻值 ↔ 温度 双向精算"
                        android:textColor="@color/lab_text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/LabInputLayout"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:hint="输入阻值 (Ω) → 算温度">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etToolResInput"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="monospace"
                                android:inputType="numberDecimal"
                                android:text="3.9854"
                                android:textColor="@color/lab_text_primary" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/LabInputLayout"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:hint="输入温度 (℃) → 算阻值">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etToolTempInput"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="monospace"
                                android:inputType="numberDecimal|numberSigned"
                                android:text="30.0"
                                android:textColor="@color/lab_text_primary" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvToolReverseOutput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_hud_card"
                        android:fontFamily="monospace"
                        android:lineSpacingExtra="4dp"
                        android:padding="10dp"
                        android:textColor="@color/lab_cyan"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- 工具 2：两点实测反算 B 值 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_lab_card"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2. 实测两点法反算 B 值"
                        android:textColor="@color/lab_text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/LabInputLayout"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:hint="T1 (℃)">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etSolveT1"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="monospace"
                                android:inputType="numberDecimal|numberSigned"
                                android:text="25"
                                android:textColor="@color/lab_text_primary" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/LabInputLayout"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1.2"
                            android:hint="R1 (Ω)">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etSolveR1"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="monospace"
                                android:inputType="numberDecimal"
                                android:text="5.0"
                                android:textColor="@color/lab_text_primary" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/LabInputLayout"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:hint="T2 (℃)">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etSolveT2"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="monospace"
                                android:inputType="numberDecimal|numberSigned"
                                android:text="50"
                                android:textColor="@color/lab_text_primary" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/LabInputLayout"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.2"
                            android:hint="R2 (Ω)">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etSolveR2"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="monospace"
                                android:inputType="numberDecimal"
                                android:text="1.716"
                                android:textColor="@color/lab_text_primary" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvSolvedBResult"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="monospace"
                            android:text="估算 B 值: 4100.0 K"
                            android:textColor="@color/lab_amber"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnApplySolvedB"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:backgroundTint="@color/lab_amber_dim"
                            android:text="应用到曲线"
                            android:textColor="@color/lab_amber"
                            android:textSize="11.5sp"
                            app:cornerRadius="8dp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 工具 3：串联分压 & ADC 曲线仿真 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_lab_card"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="3. 串联分压 &amp; ADC 曲线仿真"
                            android:textColor="@color/lab_text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnToggleDividerPos"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text="NTC 上拉"
                            android:textColor="@color/lab_emerald"
                            android:textSize="11sp"
                            app:cornerRadius="8dp"
                            app:strokeColor="@color/lab_border" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/LabInputLayout"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:hint="VCC (V)">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etDivVcc"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="monospace"
                                android:inputType="numberDecimal"
                                android:text="3.3"
                                android:textColor="@color/lab_text_primary" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/LabInputLayout"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="4dp"
                            android:layout_weight="1.2"
                            android:hint="匹配电阻 Rref (Ω)">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etDivRref"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="monospace"
                                android:inputType="numberDecimal"
                                android:text="5.0"
                                android:textColor="@color/lab_text_primary" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/LabInputLayout"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:layout_weight="0.9"
                            android:hint="ADC 位">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etDivAdcBits"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="monospace"
                                android:inputType="number"
                                android:text="12"
                                android:textColor="@color/lab_text_primary" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvDivHud"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="monospace"
                        android:text="25.0℃ → Vout=1.650V · ADC=2048"
                        android:textColor="@color/lab_emerald"
                        android:textSize="12sp" />

                    <com.ntcrt.pro.VoltageCurveView
                        android:id="@+id/voltageCurveView"
                        android:layout_width="match_parent"
                        android:layout_height="185dp"
                        android:layout_marginTop="8dp" />
                </LinearLayout>

            </LinearLayout>
        </ScrollView>

    </FrameLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/lab_border" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/lab_surface"
        app:itemActiveIndicatorStyle="@null"
        app:itemIconTint="@color/lab_cyan"
        app:itemTextColor="@color/lab_text_primary"
        app:menu="@menu/menu_bottom_nav" />

</LinearLayout>
